# =====================================================
# Supabase - cotton-dashboard
# =====================================================
# 1. Crie um projeto em https://supabase.com (free tier OK).
# 2. Em Project Settings > API copie:
#    - Project URL  -> NEXT_PUBLIC_SUPABASE_URL
#    - anon public  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role -> SUPABASE_SERVICE_ROLE_KEY (NUNCA expor no client)
# 3. Copie este arquivo para .env.local e preencha.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# Senha de acesso ao painel /admin (qualquer string forte)
ADMIN_PASSWORD=troque-esta-senha-forte

# =====================================================
# Google Maps Platform
# =====================================================
# APIs a habilitar no Google Cloud Console:
#   - Routes API           (calculo de rotas)
#   - Places API (New)     (autocomplete + text search no script enrich:cep)
#   - Geocoding API        (admin: endereco -> lat/lng)
# A chave eh usada SOMENTE server-side (server actions e route handlers).
GOOGLE_MAPS_API_KEY=AIza...

# Limite de requests por minuto por IP nos endpoints /api/places/*
# (opcional; default = 30 se nao setada)
GOOGLE_PLACES_RATE_LIMIT_PER_MIN=30
